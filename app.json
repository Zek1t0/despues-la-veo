{
  "expo": {
    "name": "DespuésLaVeo",
    "slug": "despues-la-veo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/branding/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#15111D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zekito.despueslaveo"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive/foreground.png",
        "backgroundImage": "./assets/branding/adaptive/background.png",
        "monochromeImage": "./assets/branding/monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.zekito.despueslaveo"
    },
    "web": {
      "favicon": "./assets/branding/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store"
    ]
  }
}
